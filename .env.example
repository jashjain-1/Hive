# Local stdio
HIVE_REPO_ROOT=.
# HIVE_DB_PATH=
HIVE_TENANT_ID=default
HIVE_EMBEDDINGS=off

# Hosted gateway
PORT=3000
# HIVE_API_KEY=replace-with-a-long-random-string
# HIVE_DATA_ROOT=/var/hive-data
HIVE_MAX_FILES=5000
HIVE_MAX_FILE_BYTES=2000000
HIVE_MAX_TENANTS=50
HIVE_RATE_LIMIT=120
HIVE_CORS_ORIGIN=*
HIVE_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
HIVE_GIT_TIMEOUT_MS=180000
HIVE_ALLOW_QUERY_KEY=false

# Server-side token for private repository clones (optional)
# GITHUB_TOKEN=
